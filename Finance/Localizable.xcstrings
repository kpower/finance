      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup has format version %lld and was created by a newer version of Finance. Update the app to load it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бэкап имеет формат версии %lld и создан более новой версией Finance. Обновите приложение, чтобы загрузить его."
          }
        }
      }
    },
